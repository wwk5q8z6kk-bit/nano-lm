{
  "schema": "nano-lm.wedge_v1.field_registry.v1",
  "note": "Corpus-agnostic typed fields for W3 epistemic merge. Extend here instead of hardcoding fixture-only extractors.",
  "fields": [
    {
      "field_id": "ttl_seconds",
      "pattern": "TTL(?:\\s+as|\\s+is|\\s*[=:]\\s*|\\s+of)\\s+(\\d+)\\s+seconds",
      "value_type": "number",
      "term_hints": ["ttl", "cache", "expire", "timeout", "invalidation", "cached"]
    },
    {
      "field_id": "metformin_dose_mg",
      "pattern": "metformin\\s+(\\d+)\\s*mg",
      "value_type": "number",
      "term_hints": ["metformin", "dose", "mg"]
    },
    {
      "field_id": "sample_n",
      "pattern": "\\bn\\s*=\\s*(\\d+)\\b",
      "value_type": "number",
      "term_hints": ["sample", "n=", "n =", "sample size"]
    },
    {
      "field_id": "peak_qps",
      "pattern": "(?:peak\\s+)?QPS\\s+(?:is|remains|=|:)?\\s*(\\d+)",
      "value_type": "number",
      "term_hints": ["qps", "throughput", "queries per second", "peak qps"]
    },
    {
      "field_id": "error_rate",
      "pattern": "error[_\\s-]?rate\\s*(?:is|=|:)?\\s*([0-9]*\\.?[0-9]+)\\s*%?",
      "value_type": "number",
      "term_hints": ["error rate", "error_rate", "err rate"]
    }
  ]
}
