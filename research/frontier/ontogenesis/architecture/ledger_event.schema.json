{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nano LM additive research decision event",
  "description": "One immutable event per JSONL line; canonical research ledger remains separate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "event_id",
    "recorded_at_utc",
    "status",
    "decision",
    "rationale",
    "alternatives_considered",
    "evidence_type",
    "source_refs",
    "next_gate",
    "supersedes_ids",
    "affected_model",
    "permission_class",
    "outcome",
    "open_questions"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "pattern": "^D-[0-9]{3}$"
    },
    "event_id": {
      "type": "string",
      "minLength": 8
    },
    "recorded_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "proposed",
        "reviewed",
        "mathematically_checked",
        "preregistered",
        "exploratory",
        "confirmed",
        "rejected",
        "superseded",
        "integrated"
      ]
    },
    "decision": {
      "type": "string",
      "minLength": 10
    },
    "rationale": {
      "type": "string",
      "minLength": 12
    },
    "alternatives_considered": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "evidence_type": {
      "enum": [
        "mathematical",
        "repository",
        "peer_reviewed",
        "preprint",
        "hypothesis",
        "engineering"
      ]
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "next_gate": {
      "type": "string",
      "minLength": 2
    },
    "supersedes_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^D-[0-9]{3}$"
      }
    },
    "affected_model": {
      "type": "string"
    },
    "permission_class": {
      "enum": [
        "review_only",
        "free_exploratory",
        "paid_authorized",
        "merge_authorized"
      ]
    },
    "outcome": {
      "enum": [
        "not_executed",
        "document_only",
        "pilot",
        "confirmed",
        "inconclusive",
        "rejected"
      ]
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
