#!/usr/bin/env bash
# Best-effort stale lease cleanup on merge.
top=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || echo "$top/.git")
if [ -f "$top/scripts/agent_coord.py" ]; then
  python3 "$top/scripts/agent_coord.py" gc >/dev/null 2>&1 || true
elif [ -f "$common/agent-coord/agent_coord.py" ]; then
  python3 "$common/agent-coord/agent_coord.py" gc >/dev/null 2>&1 || true
fi
exit 0
