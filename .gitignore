# Large / local training artifacts
*.pt
*.npy
*.jsonl
raw_corpus*
clean_corpus*
sft_convos.json
checkpoints/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Editor / OS
.DS_Store
.cursor/
.idea/
.vscode/
*.swp

# Local agent scratch (not evidence)
.autonomous/
audit/**/PRE_EDIT_SNAPSHOT.*

# LaTeX intermediates (PDF tracked when rebuilt)
papers/latex/*.aux
papers/latex/*.log
papers/latex/*.out
papers/latex/*.toc
papers/latex/*.blg

# Durable raw evidence (explicitly tracked; overrides *.jsonl ignore)
!artifacts/durable_raw/
!artifacts/durable_raw/**


# Benchmark lab generated runs (Program 0+)
experiments/**/runs/
experiments/**/runs/**
!experiments/**/runs/.gitkeep
# Allow committed golden fixtures under adapters
!benchmarks/adapters/**/fixtures/**
!benchmarks/adapters/**/fixtures/**/*.json

.venv-bench/

# P1 harness outputs (external to git; summaries in frontier/*.json)
artifacts/p1_runs/

# Campaign runtime logs (summaries tracked as JSON)
artifacts/campaign/*.log

# Native checkpoint weights (step_*.json metrics may be tracked selectively)
artifacts/native_checkpoints/

# Regenerated on every CPU smoke test run (timestamps churn); not a durable artifact.
artifacts/native_checkpoints/smoke_cpu/

# Generated corpora are deterministic — rebuild with scripts/build_native_corpus.py
# and verify against the manifest content_hash. The generator + manifest are the
# durable artifacts; the expanded JSON is not (66MB of it was committed once).
artifacts/campaign/native_corpus_*_train.json
artifacts/campaign/native_corpus_*_dev.json
artifacts/campaign/native_corpus_*_internal_test.json
