# Large / local training artifacts
*.pt
*.npy
*.jsonl
raw_corpus*
clean_corpus*
sft_convos.json
checkpoints/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Editor / OS
.DS_Store
.cursor/
.idea/
.vscode/
*.swp

# Local agent scratch (not evidence)
.autonomous/

# LaTeX intermediates (PDF tracked when rebuilt)
papers/latex/*.aux
papers/latex/*.log
papers/latex/*.out
papers/latex/*.toc
papers/latex/*.blg

# Durable raw evidence (explicitly tracked; overrides *.jsonl ignore)
!artifacts/durable_raw/
!artifacts/durable_raw/**

# Generated benchmark regression runs
experiments/**/runs/
experiments/**/runs/**
!experiments/**/runs/.gitkeep
# Allow committed golden fixtures under adapters
!benchmarks/adapters/**/fixtures/**
!benchmarks/adapters/**/fixtures/**/*.json

.venv-bench/

